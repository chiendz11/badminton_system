{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["environment", "workloadNamespace", "monitoringRelease", "services", "dashboards"],
  "properties": {
    "environment": {"type": "string", "minLength": 1},
    "workloadNamespace": {"type": "string", "minLength": 1},
    "monitoringRelease": {"type": "string", "minLength": 1},
    "scrapeInterval": {"type": "string", "pattern": "^[1-9][0-9]*(ms|s|m|h)$"},
    "dashboards": {
      "type": "object",
      "required": ["enabled", "namespace"],
      "properties": {
        "enabled": {"type": "boolean"},
        "namespace": {"type": "string", "minLength": 1}
      }
    },
    "services": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["enabled"],
        "properties": {"enabled": {"type": "boolean"}}
      }
    }
  }
}
