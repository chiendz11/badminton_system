{
  "name": "badminton-system",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.25.0",
  "scripts": {
    "prepare": "pnpm --filter \"./packages/**\" build",
    "dev:core": "pnpm --filter @badminton/booking-core dev",
    "dev:web": "pnpm --filter @badminton/frontend dev",
    "dev:admin": "pnpm --filter @badminton/admin dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test:unit": "pnpm -r test:unit",
    "test:integration": "pnpm --filter @badminton/booking-core test:integration",
    "test:contract": "pnpm -r test:contract",
    "demo:tokens": "pnpm --filter @badminton/booking-core demo:tokens",
    "format": "prettier --write packages services Frontend Admin contracts docs monitoring *.json *.yml *.yaml"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "eslint": "^9.39.0",
    "typescript-eslint": "^8.46.0",
    "globals": "^16.5.0",
    "@types/node": "^22.18.0",
    "prettier": "^3.6.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild"
    ]
  }
}
