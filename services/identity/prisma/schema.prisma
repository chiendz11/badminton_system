generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Values match @badminton/auth-contracts. API/JWT uses these lowercase values.
enum Role {
  user
  center_manager
  super_admin
}

model User {
  id                 String                  @id @default(uuid()) @db.Uuid
  email              String                  @unique @db.VarChar(254)
  passwordHash       String?
  role               Role                    @default(user)
  isActive           Boolean                 @default(true)
  isVerified         Boolean                 @default(false)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  profile            Profile?
  verificationTokens EmailVerificationToken[]
  sessions           Session[]
  version            Int                     @default(1)
  centerAssignments  CenterAssignment[]
}

model Profile {
  userId String  @id @db.Uuid
  name   String  @db.VarChar(150)
  phone  String? @db.VarChar(32)
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmailVerificationToken {
  tokenHash  String    @id @db.Char(64)
  userId     String    @db.Uuid
  expiresAt  DateTime
  consumedAt DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Session {
  id            String         @id @default(uuid()) @db.Uuid
  userId        String         @db.Uuid
  createdAt     DateTime       @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model RefreshToken {
  tokenHash  String    @id @db.Char(64)
  sessionId  String    @db.Uuid
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  consumedAt DateTime?
  session    Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([expiresAt])
}

model CenterAssignment {
  centerId   String   @id @db.Uuid
  userId     String   @db.Uuid
  active     Boolean  @default(true)
  assignedBy String   @db.Uuid
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id])

  @@index([userId, active])
}

model IdentityAudit {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String   @db.Uuid
  userId    String   @db.Uuid
  action    String   @db.VarChar(32)
  reason    String   @db.VarChar(1000)
  before    Json
  after     Json
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model IdentityOutbox {
  id          String    @id @db.Uuid
  userId      String    @db.Uuid
  version     Int
  event       Json
  createdAt   DateTime  @default(now())
  publishedAt DateTime?

  @@unique([userId, version])
  @@index([publishedAt, createdAt])
}
