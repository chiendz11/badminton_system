APP_ENV=development
AI_DATABASE_URL=postgresql+psycopg://ai:ai_dev@localhost:5433/ai
BOOKING_CORE_URL=http://localhost:3000
JWT_SECRET=local-development-only-change-me-32-chars
JWT_ISSUER=badminton-identity
JWT_AUDIENCE=badminton-system
METRICS_TOKEN=local-ai-monitoring-only
AI_PROVIDER=openai-compatible
AI_OFFLINE=false
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=
# Test/demo offline: AI_PROVIDER=fake and AI_OFFLINE=true.
# OpenAI-compatible refers to the API protocol; the example above calls Groq.
# Ollama compatible API: http://localhost:11434/v1; LLM_API_KEY=ollama-local; choose an installed model.
