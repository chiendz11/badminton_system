{
  "name": "@badminton/booking-core",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec ts-node src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src test scripts",
    "typecheck": "tsc --noEmit",
    "test:unit": "jest --config jest.unit.cjs --runInBand",
    "test:integration": "jest --config jest.integration.cjs --runInBand",
    "test:contract": "jest --config jest.contract.cjs --runInBand",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "seed": "tsx prisma/seed.ts",
    "demo:tokens": "tsx scripts/demo-tokens.ts"
  },
  "dependencies": {
    "@badminton/auth-contracts": "workspace:*",
    "@badminton/booking-contracts": "workspace:*",
    "@badminton/observability": "workspace:*",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^16.6.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.6",
    "@testcontainers/postgresql": "^11.5.1",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/jest": "^30.0.0",
    "@types/supertest": "^6.0.3",
    "jest": "^30.1.3",
    "ts-jest": "^29.4.1",
    "prisma": "6.19.3",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "ts-node": "^10.9.2",
    "nodemon": "^3.1.10",
    "@prisma/client": "6.19.3"
  },
  "files": [
    "dist",
    "prisma",
    "generated/client"
  ]
}
