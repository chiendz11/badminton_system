# Docker Compose: copy to .env and add your private Groq key locally.
AI_PROVIDER=openai-compatible
AI_OFFLINE=false
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=

# Optional monitoring profile, Compose >= 2.23.1. These defaults are local only.
BOOKING_METRICS_TOKEN=local-monitoring-only
GATEWAY_METRICS_TOKEN=local-gateway-monitoring-only
AI_METRICS_TOKEN=local-ai-monitoring-only
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=local-grafana-only

# AI recommendation: proposing a change never grants permission to book.
PROPOSAL_TTL_SECONDS=300
NEAR_MISS_TIME_MINUTES=60
NEAR_MISS_PRICE_RATIO=0.2
NEAR_MISS_TOP_K=3
NEAR_MISS_WEIGHTS={"time":0.4,"price":0.4,"area":0.2}
# Explicit adjacency only. Empty means no hard-area near-miss proposals.
NEARBY_AREAS={}
MAX_SEARCH_CENTERS=5
MAX_DISCOVERY_PAGES=2
MAX_CANDIDATES=500
SEARCH_CONCURRENCY=2
SEARCH_TIMEOUT_SECONDS=10
AVAILABILITY_MAX_AGE_SECONDS=60
