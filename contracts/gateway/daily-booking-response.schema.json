{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Legacy daily booking confirmed without payment",
  "type": "object",
  "required": [
    "message",
    "booking"
  ],
  "properties": {
    "message": {
      "type": "string"
    },
    "booking": {
      "type": "object",
      "required": [
        "_id",
        "bookingStatus",
        "price",
        "courtBookingDetails",
        "userId",
        "bookDate"
      ],
      "properties": {
        "_id": {
          "type": "string",
          "format": "uuid"
        },
        "bookingStatus": {
          "const": "confirmed"
        },
        "price": {
          "type": "integer",
          "minimum": 0
        },
        "userId": {
          "type": "string",
          "minLength": 1
        },
        "bookDate": {
          "type": "string",
          "format": "date"
        },
        "courtBookingDetails": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "courtId",
              "timeslots"
            ],
            "properties": {
              "courtId": {
                "type": "string",
                "format": "uuid"
              },
              "timeslots": {
                "type": "array",
                "minItems": 1,
                "maxItems": 19,
                "uniqueItems": true,
                "items": {
                  "type": "integer",
                  "minimum": 5,
                  "maximum": 23
                }
              }
            }
          }
        }
      }
    }
  }
}
