{
  "openapi": "3.0.3",
  "info": {
    "title": "Booking Core legacy gateway",
    "version": "1.0.0",
    "description": "Routes retained from BM/api_gateway. Gateway forwards verified bearer tokens to Booking Core. No auth, payment, resale or other-domain routes."
  },
  "servers": [
    {
      "url": "http://localhost:8081"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "DailyRequest": {
        "title": "Legacy daily booking request",
        "type": "object",
        "required": [
          "centerId",
          "bookDate",
          "courtBookingDetails"
        ],
        "properties": {
          "centerId": {
            "type": "string",
            "format": "uuid"
          },
          "bookDate": {
            "oneOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "string",
                "format": "date-time"
              }
            ]
          },
          "userName": {
            "type": "string"
          },
          "courtBookingDetails": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "object",
              "required": [
                "courtId",
                "timeslots"
              ],
              "properties": {
                "courtId": {
                  "type": "string",
                  "format": "uuid"
                },
                "timeslots": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 19,
                  "uniqueItems": true,
                  "items": {
                    "type": "integer",
                    "minimum": 5,
                    "maximum": 23
                  }
                }
              }
            }
          }
        }
      },
      "DailyResponse": {
        "title": "Legacy daily booking confirmed without payment",
        "type": "object",
        "required": [
          "message",
          "booking"
        ],
        "properties": {
          "message": {
            "type": "string"
          },
          "booking": {
            "type": "object",
            "required": [
              "_id",
              "bookingStatus",
              "price",
              "courtBookingDetails",
              "userId",
              "bookDate"
            ],
            "properties": {
              "_id": {
                "type": "string",
                "format": "uuid"
              },
              "bookingStatus": {
                "type": "string",
                "enum": [
                  "confirmed"
                ]
              },
              "price": {
                "type": "integer",
                "minimum": 0
              },
              "userId": {
                "type": "string",
                "minLength": 1
              },
              "bookDate": {
                "type": "string",
                "format": "date"
              },
              "courtBookingDetails": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "courtId",
                    "timeslots"
                  ],
                  "properties": {
                    "courtId": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "timeslots": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 19,
                      "uniqueItems": true,
                      "items": {
                        "type": "integer",
                        "minimum": 5,
                        "maximum": 23
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "paths": {
    "/api/booking/pending/pendingBookingToDB": {
      "post": {
        "summary": "Reserve then confirm directly, without payment",
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Legacy response envelope",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DailyResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Bearer token required"
          },
          "403": {
            "description": "Actor or centre access denied"
          },
          "409": {
            "description": "Slot conflict / changed idempotency replay"
          },
          "502": {
            "description": "Core unavailable"
          },
          "504": {
            "description": "Core timeout"
          }
        },
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            },
            "description": "Clients should reuse the same key for uncertain retries; omitted keys cannot deduplicate retries."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DailyRequest"
              }
            }
          }
        }
      }
    },
