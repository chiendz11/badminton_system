      },
      "RefreshCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "refresh_token",
        "description": "Proposed HttpOnly Secure cookie, SameSite/CSRF/rotation policy must be reviewed."
      },
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Current claim profile sub/role/iss/aud/exp; issuer/algorithm rollout per ADR-006."
