    "/api/conversations": {
      "post": {
        "summary": "Owner-scoped AI conversation / booking operation",
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Validated AI response"
          },
          "401": {
            "description": "JWT required"
          },
          "404": {
            "description": "Conversation not owned / missing"
          },
          "409": {
            "description": "Concurrent turn or changed replay"
          },
          "502": {
            "description": "AI unavailable"
          },
          "504": {
            "description": "AI timeout; retry same client_message_id"
          },
          "201": {
            "description": "Conversation created"
          }
        }
      }
    },
