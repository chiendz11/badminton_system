{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proposed HTTP error envelope",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "minLength": 1
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "details": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": [
    "code",
    "message",
    "requestId"
  ],
  "additionalProperties": false
}
