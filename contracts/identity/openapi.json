  "components": {
    "schemas": {
      "Actor": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "displayName": {
            "type": "string",
            "maxLength": 150
          },
          "role": {
            "type": "string",
            "enum": [
              "user",
              "center_manager",
              "super_admin"
            ]
          },
          "isActive": {
            "type": "boolean"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "userId",
          "displayName",
          "role",
          "isActive",
          "version"
        ],
        "additionalProperties": false
      },
      "Error": {
        "$ref": "../shared/error.schema.json"
      },
      "RegisterRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "username": {
            "type": "string",
            "minLength": 3,
            "maxLength": 80
          },
          "password": {
            "type": "string",
            "minLength": 12,
            "maxLength": 128,
            "writeOnly": true
          }
        },
        "required": [
          "email",
          "username",
          "password"
        ],
        "additionalProperties": false
      },
      "TokenResponse": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "minLength": 1
          },
          "tokenType": {
            "type": "string",
            "enum": [
              "Bearer"
            ]
          },
          "expiresIn": {
            "type": "integer",
            "minimum": 1
          },
          "actor": {
            "$ref": "#/components/schemas/Actor"
          }
        },
        "required": [
          "accessToken",
          "tokenType",
          "expiresIn",
          "actor"
        ],
        "additionalProperties": false
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "writeOnly": true
          }
        },
        "required": [
          "email",
          "password"
        ],
        "additionalProperties": false
      },
      "ProfileUpdate": {
        "type": "object",
        "properties": {
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150
          },
          "avatarFileId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "displayName"
        ],
        "additionalProperties": false
      },
      "RoleUpdate": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user",
              "center_manager",
              "super_admin"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
