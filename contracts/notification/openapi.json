  "components": {
    "schemas": {
      "NotificationPage": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Notification"
            }
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "items",
          "nextCursor"
        ],
        "additionalProperties": false
      },
      "Notification": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "recipientUserId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "eventId": {
            "type": "string",
            "format": "uuid"
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "maxLength": 2000
          },
          "isRead": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "recipientUserId",
          "eventId",
          "type",
          "message",
          "isRead",
          "createdAt"
        ],
        "additionalProperties": false
      },
      "Error": {
        "$ref": "../shared/error.schema.json"
      },
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "live",
              "ready"
            ]
          }
        },
        "required": [
          "status"
        ],
        "additionalProperties": false
      },
      "BroadcastNotificationRequest": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "targetAudience": {
            "type": "string",
            "enum": [
              "ALL",
              "MANAGERS",
              "PLAYERS"
            ],
            "default": "ALL"
          },
          "priority": {
            "type": "string",
            "enum": [
              "NORMAL",
              "HIGH",
              "URGENT"
            ],
            "default": "NORMAL"
          }
        },
        "required": [
          "title",
          "message"
        ],
        "additionalProperties": false
      },
      "BroadcastNotificationResponse": {
        "type": "object",
        "properties": {
          "broadcastId": {
            "type": "string",
            "format": "uuid"
          },
          "recipientCount": {
            "type": "integer",
            "minimum": 0
          },
          "sentAt": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string",
            "enum": [
              "SENT",
              "QUEUED"
            ]
          }
        },
        "required": [
          "broadcastId",
          "recipientCount",
          "sentAt",
          "status"
        ],
        "additionalProperties": false
      },
      "UrgentNotificationRequest": {
        "type": "object",
        "properties": {
          "centerId": {
            "type": "string",
            "format": "uuid"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "courtIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "actionRequired": {
            "type": "string",
            "enum": [
              "NOTICE_ONLY",
              "REFUND_PENDING",
              "RELOCATE"
            ],
            "default": "NOTICE_ONLY"
          }
        },
        "required": [
          "centerId",
          "date",
          "title",
          "message"
        ],
        "additionalProperties": false
      },
      "UrgentNotificationResponse": {
        "type": "object",
        "properties": {
          "urgentId": {
            "type": "string",
            "format": "uuid"
          },
          "centerId": {
            "type": "string",
            "format": "uuid"
          },
          "impactedBookingsCount": {
            "type": "integer",
            "minimum": 0
          },
          "sentAt": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string",
            "enum": [
              "DELIVERED"
            ]
          }
        },
        "required": [
          "urgentId",
          "centerId",
          "impactedBookingsCount",
          "sentAt",
          "status"
        ],
        "additionalProperties": false
      }
    },
    "responses": {
      "Error400": {
        "description": "Validation error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Error401": {
        "description": "Authentication required/invalid",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Error403": {
        "description": "Resource scope denied",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Error404": {
        "description": "Resource not found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Error409": {
        "description": "State, stock or idempotency conflict",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Error429": {
        "description": "Rate limit exceeded",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Error503": {
        "description": "Dependency unavailable",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "parameters": {
      "XRequestId": {
        "name": "X-Request-Id",
        "in": "header",
        "required": false,
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 8,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "description": "Khóa chống trùng lặp yêu cầu gửi thông báo"
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Current claim profile sub/role/iss/aud/exp; issuer/algorithm rollout per ADR-006."
      }
    }
  },
  "x-owner": "Người 3",
  "x-implementation-status": "proposed"
}
