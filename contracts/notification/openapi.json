    "/notifications/urgent": {
      "post": {
        "operationId": "sendUrgentNotification",
        "tags": [
          "Notification"
        ],
        "summary": "Center Manager phát thông báo khẩn cấp tại cơ sở",
        "description": "Center Manager gửi thông báo khẩn cấp (thời tiết mưa bão, sự cố kỹ thuật hỏng đèn, bảo trì khẩn) tới tất cả người chơi có lịch đặt sân bị ảnh hưởng trong ngày tại cơ sở.",
        "x-delivery-status": "proposed",
        "x-owner-policy": "center_manager of centerId or super_admin.",
        "responses": {
          "200": {
            "description": "Đã gửi thông báo khẩn cấp thành công",
            "headers": {
              "X-Request-Id": {
                "schema": {
