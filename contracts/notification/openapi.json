    "/notifications/broadcast": {
      "post": {
        "operationId": "broadcastNotification",
        "tags": [
          "Notification"
        ],
        "summary": "Super Admin phát thông báo toàn hệ thống",
        "description": "Super Admin phát thông báo hệ thống (bảo trì sàn, chính sách mới, thông báo nghỉ lễ) tới toàn bộ người dùng, chủ sân hoặc phân nhóm chỉ định.",
        "x-delivery-status": "proposed",
        "x-owner-policy": "super_admin only.",
        "responses": {
          "202": {
            "description": "Đã tiếp nhận và đưa vào hàng đợi phát thông báo",
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "type": "string"
                },
                "description": "Correlation ID"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BroadcastNotificationResponse"
                }
              }
            }
          },
