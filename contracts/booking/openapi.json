  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "CreateReservation": {
        "title": "CreateReservation",
        "type": "object",
        "required": [
          "centerId",
          "date",
          "selections"
        ],
        "additionalProperties": false,
        "properties": {
          "centerId": {
            "type": "string",
            "format": "uuid"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "selections": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "object",
              "required": [
                "courtId",
                "slots"
              ],
              "additionalProperties": false,
              "properties": {
                "courtId": {
                  "type": "string",
                  "format": "uuid"
                },
                "slots": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 24,
                  "uniqueItems": true,
                  "items": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1380,
                    "multipleOf": 60
                  }
                }
              }
            }
          }
        }
      },
      "Reservation": {
        "title": "Reservation",
        "type": "object",
        "required": [
          "id",
          "centerId",
          "userId",
          "date",
          "status",
          "expiresAt",
          "totalPrice",
          "selections"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "centerId": {
            "type": "string",
            "format": "uuid"
          },
          "userId": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "status": {
            "enum": [
              "HELD",
              "CONFIRMED",
              "EXPIRED",
              "CANCELLED"
            ]
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "totalPrice": {
            "type": "integer",
            "minimum": 0
          },
          "selections": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "courtId",
                "courtName",
                "slots",
                "price"
              ],
              "properties": {
                "courtId": {
                  "type": "string",
                  "format": "uuid"
                },
                "slots": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 24,
                  "uniqueItems": true,
                  "items": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1380,
                    "multipleOf": 60
                  }
                },
                "courtName": {
                  "type": "string"
                },
                "price": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      },
      "Booking": {
        "title": "Booking",
        "type": "object",
        "required": [
          "id",
          "reservationId",
          "centerId",
          "centerName",
          "userId",
          "userName",
          "date",
          "status",
          "type",
          "totalPrice",
          "createdAt",
          "selections"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "centerId": {
            "type": "string",
            "format": "uuid"
          },
          "userId": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "totalPrice": {
            "type": "integer",
            "minimum": 0
          },
          "selections": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "courtId",
                "courtName",
                "slots",
                "price"
              ],
              "properties": {
                "courtId": {
                  "type": "string",
                  "format": "uuid"
                },
                "slots": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 24,
                  "uniqueItems": true,
                  "items": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1380,
                    "multipleOf": 60
                  }
                },
                "courtName": {
                  "type": "string"
                },
                "price": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          },
          "reservationId": {
            "type": "string",
            "format": "uuid"
          },
          "centerName": {
            "type": "string"
          },
          "userName": {
            "type": "string"
          },
          "status": {
            "enum": [
              "CONFIRMED",
              "CANCELLED"
            ]
          },
          "type": {
            "enum": [
              "DAILY",
              "FIXED"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
