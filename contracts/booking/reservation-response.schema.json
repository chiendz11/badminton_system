{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Reservation",
  "type": "object",
  "required": [
    "id",
    "centerId",
    "userId",
    "date",
    "status",
    "expiresAt",
    "totalPrice",
    "selections"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "centerId": {
      "type": "string",
      "format": "uuid"
    },
    "userId": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "enum": ["HELD", "CONFIRMED", "EXPIRED", "CANCELLED"]
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "totalPrice": {
      "type": "integer",
      "minimum": 0
    },
    "selections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["courtId", "courtName", "slots", "price"],
        "properties": {
          "courtId": {
            "type": "string",
            "format": "uuid"
          },
          "slots": {
            "type": "array",
            "minItems": 1,
            "maxItems": 24,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1380,
              "multipleOf": 60
            }
          },
          "courtName": {
            "type": "string"
          },
          "price": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
